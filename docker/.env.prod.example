# Pinecone 生产环境变量模板（docker compose --env-file .env 使用）
# 复制为 .env（生产）或 .env.prod（演练），填入强值后使用

# ── 数据库 ──
# pinecone_admin 超级用户密码（≥16 字符强随机，勿与登录账号复用）
DB_PASSWORD=your_strong_db_admin_password_here
# pinecone_app 应用用户密码（≥16 字符强随机，勿复用；后端运行时建议用它连接）
# 生成方式: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_DB_PASSWORD=your_strong_db_app_password_here

# ── JWT（生产必须 ≥32 字符强随机，否则后端启动直接失败）──
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# ── URLs ──
# 生产必须显式设置为真实前端地址（CORS 白名单 + WebSocket）
FRONTEND_URL=http://localhost:6173
API_URL=http://localhost:3000/api
WS_URL=http://localhost:3000/ws

# ── Cookie 安全（verify2 F-003）──
# 生产走 HTTPS 反代时设 true（cookie Secure=true）；仅内部 http 部署保持 false
COOKIE_SECURE=false

# ── Ports ──
# 后端对外端口（容器内固定 3000）
BACKEND_PORT=3000
# 前端对外端口（容器内固定 3000，next start 默认端口）
FRONTEND_PORT=6173

# ── 注册控制（发布门禁 Fix#2：生产未显式设置时 fail-closed=whitelist，绝不静默开放）──
# open=任何人可注册（公网慎用）；whitelist=仅白名单邮箱可注册；invite=需邀请码注册
REGISTRATION_MODE=whitelist
# 可管理白名单/邀请码/用户禁用/用户列表的管理员邮箱（逗号分隔；未配置=管理端全部 403）
REGISTRATION_ADMIN_EMAILS=admin@example.com

# ── SMTP（密码重置 / to-do 通知邮件；未配置时这些邮件功能不可用）──
# 163 邮箱示例：EMAIL_HOST=smtp.163.com, EMAIL_PORT=465, EMAIL_SECURE=true,
# EMAIL_USER=your_account@163.com, EMAIL_PASS=你的SMTP授权码（非登录密码）
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_account@163.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_FROM=Pinecone <your_account@163.com>

# ============================================================
# TLS 反向代理（部署前置 · 非应用代码改动）
# ============================================================
# 源码发布包不需要正规 CA 证书；TLS 终结是「部署方」的生产职责。
# 推荐在 backend(3000) / frontend(6173) 前置 LB / 反代（Nginx / Caddy / Traefik / 云 LB），
# 于 443 用正规证书终止 HTTPS，再以内网 HTTP 转发到后端。
# 后端已就绪：main.ts 读 TRUST_PROXY；Cookie 的 Secure 随 x-forwarded-proto: https 自动生效。
# 故本段全部为「部署配置」，无需改动任何应用代码。
#
# —— 启用反代卸载 TLS（推荐拓扑）时，取消下面注释并填公网域名 ——
#
# 后端关闭自带 TLS（改由反代统一终结，内网明文转发）
# HTTPS_ENABLED=false
#
# 信任代理跳数：设为反代跳数或 IP（如 1）。默认 'loopback' 会导致 req.ip 退化为反代 IP
# → 限流失效、审计 IP 失真（生产必设）。
# TRUST_PROXY=1
#
# Cookie 安全：反代透传 x-forwarded-proto=https 时本会自动 Secure；生产显式 true 更稳妥。
# COOKIE_SECURE=true
#
# 公网域名（替换上方 http://localhost）：影响 CORS 白名单 / 服务端 fetch / WebSocket 升级。
# 注意：下方 FRONTEND_URL / API_URL / WS_URL 已在上方定义，生产请改为 https / wss 公网地址。
#   FRONTEND_URL=https://pinecone.example.com
#   API_URL=https://pinecone.example.com/api
#   WS_URL=wss://pinecone.example.com/ws
#
# 前端构建时内联（NEXT_PUBLIC_*）：换域名必须重新 build 前端，仅改 env 重启不生效。
# NEXT_PUBLIC_API_URL=https://pinecone.example.com/api
# NEXT_PUBLIC_WS_URL=wss://pinecone.example.com/ws

