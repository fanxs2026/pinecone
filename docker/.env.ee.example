# Pinecone 企业版（Enterprise Edition）生产环境变量模板
# 复制为 docker/.env.ee 后填入强值：cp docker/.env.ee.example docker/.env.ee
# 启动：PINE_IMAGE_TAG=vX.Y.Z-<sha> docker compose -f docker-compose.ee.yml --env-file docker/.env.ee up -d

# ── 版本（社区版 / 企业版）──
PINE_EDITION=enterprise

# 发布镜像 tag（由 scripts/release-images.sh 打印；回滚=填上一版 tag）
# PINE_IMAGE_TAG=v1.0.0-abc1234

# ── 数据库 ──
DB_PASSWORD=your_strong_db_admin_password_here
APP_DB_PASSWORD=your_strong_db_app_password_here

# ── JWT（生产必须 ≥32 字符强随机，否则后端启动直接失败）──
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# ── URLs ──
FRONTEND_URL=http://localhost:6173
API_URL=http://localhost:3000/api
WS_URL=http://localhost:3000/ws

# ── Cookie 安全 ──
COOKIE_SECURE=false

# ── Ports ──
BACKEND_PORT=3000
FRONTEND_PORT=6173

# ── 注册控制（生产未显式设置时 fail-closed=whitelist）──
REGISTRATION_MODE=whitelist
REGISTRATION_ADMIN_EMAILS=admin@example.com

# ── SMTP ──
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_account@163.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_FROM=Pinecone <your_account@163.com>

# ── 企业版专用（按实际开通的能力配置；未配置时对应功能不可用，但不影响其他功能）──
# SSO / SAML / SCIM 等凭据与开关请参考 deliverables/sso-enterprise-guide-1.0.0.md
# FIELD_ENCRYPTION_SECRET 建议独立设置（SSO clientSecret / Webhook secret 可逆密文 AES-256-GCM）
# FIELD_ENCRYPTION_SECRET=your-field-encryption-secret
