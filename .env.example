# Pinecone 环境变量配置
# 复制此文件为 .env 并根据需要修改

# === 版本（社区版 / 企业版）===
# PINE_EDITION=community | enterprise（默认 community，fail-closed）
# 企业版功能（SSO/SCIM/审计/GitHub/Webhook/自动化/API Token/团队/回收站/AI/OKR）
# 在社区版部署下：前端入口完全隐藏 + 后端接口 403 拦截
PINE_EDITION=community

# === 数据库 ===
# PostgreSQL 连接字符串（本地开发）
DATABASE_URL=postgresql://pinecone_admin:${DB_PASSWORD}@localhost:5432/pinecone
DB_PASSWORD=pinecone_dev_pwd
# P2-③：app 用户（最小权限，仅 DML）密码——init-v2/01-init.sh 创建用户时读取，
# 不得硬编码进 SQL；生产必须为独立强随机值（勿与 DB_PASSWORD 复用）
APP_DB_PASSWORD=pinecone_dev_app_pwd

# === JWT 认证 ===
# 用于签发和验证 access token（必填；生产环境必须 ≥32 字符的强随机值，否则应用拒绝启动）
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-here
# 用于签发和验证 refresh token（必填；生产环境必须 ≥32 字符的强随机值）
JWT_REFRESH_SECRET=your-refresh-secret-here

# === 敏感字段加密（P1-⑤，建议配置）===
# SSO clientSecret / Webhook secret 等可逆密文的 AES-256-GCM 加密密钥（独立于 JWT，密钥用途隔离）。
# 未配置时回退 JWT_ACCESS_SECRET（兼容存量密文）；新部署建议配置独立强随机值，
# 防止 JWT 密钥泄露连带解密全部敏感密文。
#FIELD_ENCRYPTION_SECRET=your-field-encryption-secret

# === Redis ===
REDIS_URL=redis://localhost:6379

# === 前端 ===
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=http://localhost:3000/ws

# === CORS ===
FRONTEND_URL=http://localhost:6173

# === Docker 部署 ===
# DB_PASSWORD 和 JWT secrets 同上
BACKEND_PORT=3000
FRONTEND_PORT=6173
API_URL=http://localhost:3000/api
WS_URL=http://localhost:3000/ws

# ── SMTP 邮件（忘记密码用）──
# EMAIL_PASS 是 163 邮箱的 SMTP 授权码（登录网页版 163 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务后生成），不是登录密码
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USER=your_email@163.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_FROM=Pinecone <your_email@163.com>

# ── HTTPS ──
# 本地：bash scripts/gen-cert.sh 生成自签名证书；生产：替换为正式证书（Let's Encrypt 等）路径
HTTPS_ENABLED=false
HTTPS_CERT_PATH=certs/pinecone.crt
HTTPS_KEY_PATH=certs/pinecone.key
COOKIE_SECURE=false
# 生产部署的 TLS 反代参数（TRUST_PROXY / 公网域名 / HTTPS_ENABLED=false 等）见
# docker/.env.prod.example 末尾的「TLS 反向代理」注释块，此处开发环境不反代，无需配置。

# ── 知识库实时协同（Yjs）──
# KB_COLLAB_PORT=3002
# 协同态持久化目录（y-leveldb 落盘，重启不丢未保存的协同编辑；默认 <项目根>/data/kb-collab）
KB_COLLAB_PERSIST_DIR=data/kb-collab

# ── AI 摘要（BYO Endpoint：客户自带模型网关）──
# 不配置 AI_API_KEY 时功能正常（AI 摘要用模板降级）；配置后启用 LLM 生成摘要。
# 网关需兼容 OpenAI Chat Completions API（/v1/chat/completions）：
#   · 官方 OpenAI：        AI_BASE_URL=https://api.openai.com/v1
#   · 企业自有网关/代理：   AI_BASE_URL=https://<your-gateway>/v1（配对应 Bearer Key）
#   · 内网本地模型(Ollama)：AI_BASE_URL=http://<内网IP>:11434/v1（Ollama 内置 OpenAI 兼容端点，Key 任意非空）
#AI_API_KEY=sk-your-key
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini
